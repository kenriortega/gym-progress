# Desarrollo local: PostgreSQL en Docker (docker compose up -d).
# En producción esta variable apunta a Neon y se define en Vercel,
# no en este archivo. Las credenciales de Neon viven en .env.neon,
# que no se versiona, y se usan con: npm run db:migrate:prod
DATABASE_URL=postgresql://gym_progress:local_only_change_me@localhost:5432/gym_progress

# Genera uno propio con `npx auth secret`. El de producción debe ser
# distinto del de desarrollo y definirse en Vercel.
AUTH_SECRET=generate-with-npx-auth-secret
AUTH_TRUST_HOST=true

# Cliente OAuth de Google. Añade estas URIs de redirección autorizadas:
#   http://localhost:3000/api/auth/callback/google
#   https://TU-DOMINIO/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# PostHog, la analítica de la app. El token es público (va al navegador) y
# solo permite enviar eventos, no leerlos. Lo encuentras en los ajustes de tu
# proyecto de PostHog.
# El host es /ingest: el proxy inverso que definen los rewrites de
# next.config.ts, para que los bloqueadores de rastreo no corten los eventos.
# Si prefieres saltártelo, pon aquí https://us.i.posthog.com (o el host eu
# equivalente) y los eventos irán directos a PostHog.
# Si faltan estas dos variables, la app funciona igual, solo que sin analítica.
# En producción se definen en Vercel.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_tu_token_de_proyecto
NEXT_PUBLIC_POSTHOG_HOST=/ingest
